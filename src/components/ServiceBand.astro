---
// Leistungsübersicht. Bewusst als Band in Primärfarbe, damit es sich vom
// übrigen Seitenfluss abhebt und als Zusammenfassung gelesen wird.
//
// Achtung: Jeder Punkt hier ist ein Leistungsversprechen. Änderungen bitte
// mit dem anpassenden Akustiker abstimmen — insbesondere die Servicedauer
// und das Zubehör.

const service = [
  {
    text: '30 Tage kostenlos testen',
    icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  },
  {
    text: 'Erst zahlen, wenn Sie zufrieden sind',
    icon: '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>',
  },
  {
    text: 'Kostenloser Hin- und Rückversand',
    icon: '<rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>',
  },
  {
    text: '6 Jahre Wartung und Service',
    icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  },
  {
    text: 'Professionelle Fernanpassung',
    icon: '<path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/>',
  },
]

const zubehoer = [
  {
    text: 'Reinigungsset',
    icon: '<path d="M3 21v-4a4 4 0 0 1 8 0v4"/><path d="M7 13V3"/><path d="M14 8h7"/><path d="M17.5 3v10"/>',
  },
  {
    text: 'Schirmchen, Filter & Hörer',
    icon: '<circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="9"/>',
  },
  {
    text: 'Ladestation oder Batterien',
    icon: '<rect x="1" y="6" width="18" height="12" rx="2"/><line x1="23" y1="13" x2="23" y2="11"/><line x1="6" y1="10" x2="6" y2="14"/><line x1="10" y1="10" x2="10" y2="14"/>',
  },
]
---
<section class="service-band">
  <div class="container sb-inner">
    <div class="sb-brand">
      <span class="sb-brand-label">Vorteile bei</span>
      <span class="sb-brand-name">easy<span>Ohr</span></span>
    </div>

    <div class="sb-col">
      <h3>Unser Service</h3>
      <ul>
        {service.map(p => (
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} />
            <span>{p.text}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="sb-col">
      <h3>Bei jedem Hörgerät gratis dabei</h3>
      <ul>
        {zubehoer.map(p => (
          <li>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} />
            <span>{p.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .service-band {
    background: var(--color-primary);
    color: white;
    padding: 3.5rem 0;
  }

  .sb-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }

  .sb-brand-label {
    display: block;
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.2;
    opacity: 0.85;
  }

  .sb-brand-name {
    display: block;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.5px;
    margin-top: 0.25rem;
  }

  .sb-brand-name span {
    opacity: 0.72;
  }

  .sb-col h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .sb-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sb-col li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .sb-col svg {
    flex-shrink: 0;
    margin-top: 1px;
    opacity: 0.85;
  }

  @media (max-width: 900px) {
    .sb-inner {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .sb-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .service-band {
      padding: 2.5rem 0;
    }

    .sb-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .sb-brand-label { font-size: 1.25rem; }
    .sb-brand-name { font-size: 1.75rem; }
  }
</style>
