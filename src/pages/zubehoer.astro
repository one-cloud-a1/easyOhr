---
import BaseLayout from '../layouts/BaseLayout.astro'
import ZubehoerKatalog from '../components/ZubehoerKatalog.tsx'
import zubehoer from '../data/zubehoer.json'
import { url } from '../lib/links'
---
<BaseLayout
  title="Zubehör"
  description="Cerumenfilter und Hörgeräte-Batterien für Phonak, Oticon, Starkey und mehr. Versandkostenfrei ab 49 €."
>
  <section class="page-header">
    <div class="container">
      <h1>Zubehör & Batterien</h1>
      <p>Filter und Batterien für Ihr Hörgerät — versandkostenfrei ab 49 €.</p>
    </div>
  </section>

  <section class="section" style="padding-top: 2.5rem;">
    <div class="container zk-container">
      <ZubehoerKatalog client:load filter={zubehoer.filter} batterien={zubehoer.batterien} />
      <p class="zk-hinweis">
        Alle Preise inkl. MwSt. Angaben zum Versand finden Sie auf der Seite
        <a href={url('/versand/')}>Versand & Lieferung</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background: var(--color-secondary);
    padding: 3rem 0;
    text-align: center;
  }
  .page-header p {
    color: var(--color-text-light);
    font-size: 1.1rem;
    margin-top: 0.75rem;
  }
  .zk-container { max-width: 1080px; }
  .zk-hinweis {
    margin-top: 2rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .zk-hinweis a { color: var(--color-primary); }
</style>

<style is:global>
  .zk {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 2.5rem;
    align-items: start;
  }

  .zk-gruppe-titel { font-size: 1.35rem; margin-bottom: 0.25rem; }
  .zk-gruppe-titel:not(:first-child) { margin-top: 2.5rem; }
  .zk-gruppe-info { font-size: 0.9rem; color: var(--color-text-light); margin-bottom: 1.25rem; }

  .zk-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }

  .zk-karte {
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: white;
  }

  .zk-karte-kopf { display: flex; align-items: center; gap: 0.75rem; }
  .zk-karte-kopf h3 { font-size: 1.02rem; }
  .zk-marke {
    font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px;
    color: var(--color-text-muted); font-weight: 500;
  }
  .zk-sub { font-size: 0.8rem; color: var(--color-text-muted); }
  .zk-swatch {
    width: 26px; height: 26px; border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.12); flex-shrink: 0;
  }
  .zk-fuer { font-size: 0.82rem; color: var(--color-text-light); line-height: 1.5; }
  .zk-packung { font-size: 0.82rem; color: var(--color-text-muted); }

  .zk-feld { display: flex; flex-direction: column; gap: 0.375rem; }
  .zk-feld > span { font-size: 0.8rem; font-weight: 600; }

  .zk-check {
    display: flex; align-items: flex-start; gap: 0.5rem;
    font-size: 0.82rem; line-height: 1.45; color: var(--color-text-light); cursor: pointer;
  }
  .zk-check input { width: 1.05rem; height: 1.05rem; margin-top: 1px; flex-shrink: 0; accent-color: var(--color-primary); cursor: pointer; }
  .zk-check em { color: var(--color-text-muted); font-style: normal; }

  .zk-karte-fuss {
    display: flex; align-items: center; justify-content: space-between;
    gap: 0.75rem; margin-top: auto; padding-top: 0.5rem;
  }
  .zk-preis { font-size: 1.15rem; font-weight: 700; white-space: nowrap; }
  .zk-add {
    font-family: var(--font-sans); font-size: 0.85rem; font-weight: 600;
    padding: 0.5rem 0.875rem; border: 1.5px solid var(--color-primary);
    background: white; color: var(--color-primary); border-radius: var(--radius-sm);
    cursor: pointer; transition: all 0.15s ease; white-space: nowrap;
  }
  .zk-add:hover { background: var(--color-primary); color: white; }
  .zk-add-ok { background: var(--color-success); border-color: var(--color-success); color: white; }

  /* Warenkorb */
  .zk-cart {
    position: sticky;
    top: calc(var(--header-height) + 1rem);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    background: var(--color-secondary);
  }
  .zk-cart h2 { font-size: 1.2rem; margin-bottom: 1rem; }
  .zk-cart-leer { font-size: 0.9rem; color: var(--color-text-muted); }

  .zk-cart-liste { list-style: none; display: flex; flex-direction: column; gap: 0.875rem; }
  .zk-cart-liste li { display: grid; grid-template-columns: 1fr auto; gap: 0.375rem 0.75rem; align-items: center; }
  .zk-cart-info { display: flex; flex-direction: column; }
  .zk-cart-info strong { font-size: 0.9rem; }
  .zk-cart-info span { font-size: 0.78rem; color: var(--color-text-muted); }
  .zk-cart-menge { display: flex; align-items: center; gap: 0.5rem; }
  .zk-cart-menge button {
    width: 26px; height: 26px; border: 1px solid var(--color-border);
    background: white; border-radius: var(--radius-sm); cursor: pointer;
    font-size: 1rem; line-height: 1; color: var(--color-text);
  }
  .zk-cart-menge button:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .zk-cart-preis { font-size: 0.9rem; font-weight: 600; text-align: right; grid-column: 2; }

  .zk-cart-summe {
    margin-top: 1.25rem; padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    display: flex; flex-direction: column; gap: 0.375rem;
    font-size: 0.9rem;
  }
  .zk-cart-summe > div { display: flex; justify-content: space-between; }
  .zk-versand-hint { font-size: 0.78rem; color: var(--color-accent); }
  .zk-cart-gesamt { font-weight: 700; font-size: 1.05rem; margin-top: 0.25rem; }

  .zk-weiter, .zk-bestellen {
    width: 100%; margin-top: 1.25rem; padding: 0.875rem;
    background: var(--color-accent); color: white; border: none;
    border-radius: var(--radius-md); font-family: var(--font-sans);
    font-size: 1rem; font-weight: 600; cursor: pointer; transition: background 0.2s;
  }
  .zk-weiter:hover, .zk-bestellen:hover:not(:disabled) { background: #9A6013; }
  .zk-bestellen:disabled { opacity: 0.6; cursor: not-allowed; }

  .zk-form { margin-top: 1.25rem; display: flex; flex-direction: column; gap: 0.625rem; }
  .zk-form-row { display: flex; gap: 0.625rem; }
  .zk-form input { font-size: 0.9rem !important; height: 2.75rem !important; }
  .zk-check-dsgvo { margin-top: 0.25rem; }
  .zk-check-dsgvo a { color: var(--color-primary); text-decoration: underline; }
  .zk-fehler {
    background: var(--color-danger-light); color: var(--color-danger);
    padding: 0.625rem 0.875rem; border-radius: var(--radius-sm); font-size: 0.85rem;
  }
  .zk-form-legal { font-size: 0.75rem; color: var(--color-text-muted); line-height: 1.5; text-align: center; }

  /* Erfolg */
  .zk-erfolg { text-align: center; padding: 3rem 1rem; max-width: 480px; margin: 0 auto; }
  .zk-erfolg-icon {
    width: 60px; height: 60px; border-radius: 50%;
    background: var(--color-success-light); color: var(--color-success);
    display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem;
  }
  .zk-erfolg h2 { margin-bottom: 0.75rem; }
  .zk-erfolg p { color: var(--color-text-light); line-height: 1.7; }
  .zk-bestellnr {
    font-size: 1.5rem; font-weight: 700; letter-spacing: 2px;
    color: var(--color-primary); margin-top: 0.75rem !important;
  }

  @media (max-width: 900px) {
    .zk { grid-template-columns: 1fr; }
    .zk-cart { position: static; }
  }
</style>
