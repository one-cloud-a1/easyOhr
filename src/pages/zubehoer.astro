---
import BaseLayout from '../layouts/BaseLayout.astro'
import ZubehoerKatalog from '../components/ZubehoerKatalog.tsx'
import zubehoer from '../data/zubehoer.json'
import { url } from '../lib/links'
import '../styles/zubehoer.css'
---
<BaseLayout
  title="Zubehör"
  description="Cerumenfilter und Hörgeräte-Batterien für Phonak, Oticon, Starkey und mehr. Versandkostenfrei ab 49 €."
>
  <section class="page-header">
    <div class="container">
      <h1>Zubehör & Batterien</h1>
      <p>Filter und Batterien für Ihr Hörgerät — versandkostenfrei ab 49 €.</p>
    </div>
  </section>

  <section class="section" style="padding-top: 2.5rem;">
    <div class="container zk-container">
      <ZubehoerKatalog client:load produkte={zubehoer.produkte} />
      <p class="zk-hinweis">
        Alle Preise inkl. MwSt. Angaben zum Versand finden Sie auf der Seite
        <a href={url('/versand/')}>Versand & Lieferung</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background: var(--color-secondary);
    padding: 3rem 0;
    text-align: center;
  }
  .page-header p {
    color: var(--color-text-light);
    font-size: 1.1rem;
    margin-top: 0.75rem;
  }
  .zk-container { max-width: 1080px; }
  .zk-hinweis {
    margin-top: 2rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .zk-hinweis a { color: var(--color-primary); }
</style>
