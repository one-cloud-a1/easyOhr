---
import BaseLayout from '../layouts/BaseLayout.astro'
import KassenRechner from '../components/KassenRechner.tsx'
import products from '../data/products.json'
import { url } from '../lib/links'
import '../styles/kassenrechner.css'
import {
  FESTBETRAG_ERSTES_OHR,
  FESTBETRAG_ZWEITES_OHR,
  ZUZAHLUNG_PRO_GERAET,
  euro,
} from '../lib/kasse'

// Aufsteigend: Der Rechner startet mit dem günstigsten Gerät, damit der erste
// Eindruck der niedrigste Eigenanteil ist. Innerhalb der Familien bleibt die
// Reihenfolge dadurch ebenfalls von günstig nach teuer.
const sorted = [...products].sort((a, b) => a.privatpreis - b.privatpreis)

const faqs = [
  {
    frage: 'Zahlt jede Krankenkasse gleich viel?',
    antwort: `Ja. Der Festbetrag wird bundeseinheitlich vom GKV-Spitzenverband festgelegt und gilt bei AOK, Barmer, TK, DAK und allen anderen gesetzlichen Kassen identisch. Er beträgt ${euro(FESTBETRAG_ERSTES_OHR)} für das erste Gerät. Einzelne Kassen erstatten über Zusatzverträge etwas mehr — fragen Sie im Zweifel direkt bei Ihrer Kasse nach.`,
  },
  {
    frage: 'Warum bekomme ich für das zweite Gerät weniger?',
    antwort: `Bei einer beidohrigen Versorgung gilt für das zweite Gerät ein Abschlag von 20 Prozent, weil der Anpassaufwand geringer ist. Statt ${euro(FESTBETRAG_ERSTES_OHR)} zahlt die Kasse dafür ${euro(FESTBETRAG_ZWEITES_OHR)}. Zusammen sind das ${euro(FESTBETRAG_ERSTES_OHR + FESTBETRAG_ZWEITES_OHR)}.`,
  },
  {
    frage: 'Was ist die gesetzliche Zuzahlung?',
    antwort: `Nach § 33 SGB V zahlen gesetzlich Versicherte ${euro(ZUZAHLUNG_PRO_GERAET)} pro Hörgerät zu — bei beiden Ohren also ${euro(ZUZAHLUNG_PRO_GERAET * 2)}. Wer von der Zuzahlung befreit ist, zahlt diesen Betrag nicht.`,
  },
  {
    frage: 'Gibt es Hörgeräte ganz ohne Eigenanteil?',
    antwort: 'Ja. Jeder Akustiker muss mindestens ein zuzahlungsfreies Kassengerät anbieten, das vollständig durch den Festbetrag gedeckt ist. Diese Geräte erfüllen den Grundbedarf, verzichten aber meist auf Bluetooth, Akku und automatische Programme. Unsere Modelle liegen darüber — den Unterschied zahlen Sie als Eigenanteil.',
  },
  {
    frage: 'Brauche ich ein Rezept?',
    antwort: 'Für die Kostenübernahme durch die Krankenkasse benötigen Sie eine Verordnung Ihres HNO-Arztes. Ohne Rezept können Sie das Hörgerät als Selbstzahler bestellen — dann entfällt der Festbetrag.',
  },
  {
    frage: 'Wann zahlt die Kasse mehr?',
    antwort: 'Bei hochgradiger Schwerhörigkeit ab WHO-Grad 4 steigt der Festbetrag auf rund 865 € pro Ohr. Ihr HNO-Arzt vermerkt den Grad auf der Verordnung. Auch bei einseitiger Taubheit (CROS-Versorgung) gelten eigene Beträge.',
  },
]
---
<BaseLayout
  title="Kassen-Rechner"
  description="Was zahlt die Krankenkasse für ein Hörgerät? Berechnen Sie Ihren Eigenanteil in 30 Sekunden — mit den aktuellen Festbeträgen der gesetzlichen Krankenversicherung."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({
      '@type': 'Question',
      name: f.frage,
      acceptedAnswer: { '@type': 'Answer', text: f.antwort },
    })),
  })} />

  <section class="page-header">
    <div class="container">
      <h1>Was zahlt meine Krankenkasse?</h1>
      <p>Berechnen Sie in 30 Sekunden Ihren voraussichtlichen Eigenanteil. Wir rechnen bewusst vorsichtig — meist zahlen Sie am Ende weniger.</p>
    </div>
  </section>

  <section class="section" style="padding-top: 2.5rem;">
    <div class="container kr-container">
      <KassenRechner client:load products={sorted} />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container kr-container">
      <h2 class="kr-h2">Häufige Fragen zur Kostenübernahme</h2>
      <div class="kr-faq">
        {faqs.map(f => (
          <details class="kr-faq-item">
            <summary>{f.frage}</summary>
            <p>{f.antwort}</p>
          </details>
        ))}
      </div>

      <div class="kr-cta">
        <h3>Unsicher, welches Gerät zu Ihnen passt?</h3>
        <p>Rufen Sie uns an — wir beraten Sie kostenlos und unverbindlich.</p>
        <div class="kr-cta-actions">
          <a href={url('/hoergeraete/')} class="btn btn-primary">Hörgeräte ansehen</a>
          <a href={url('/so-funktionierts/')} class="btn btn-outline">So funktioniert's</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background: var(--color-secondary);
    padding: 3rem 0;
    text-align: center;
  }

  .page-header p {
    color: var(--color-text-light);
    font-size: 1.1rem;
    margin-top: 0.75rem;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  .kr-container { max-width: 720px; }

  .kr-h2 {
    text-align: center;
    margin-bottom: 2rem;
  }

  .kr-faq {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .kr-faq-item {
    background: white;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .kr-faq-item summary {
    padding: 1.125rem 1.25rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .kr-faq-item summary::-webkit-details-marker { display: none; }

  .kr-faq-item summary::after {
    content: '';
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--color-text-muted);
    border-bottom: 2px solid var(--color-text-muted);
    transform: rotate(45deg);
    transition: transform 0.2s;
    flex-shrink: 0;
  }

  .kr-faq-item[open] summary::after {
    transform: rotate(-135deg);
  }

  .kr-faq-item summary:hover { color: var(--color-primary); }

  .kr-faq-item p {
    padding: 0 1.25rem 1.25rem;
    color: var(--color-text-light);
    line-height: 1.7;
  }

  .kr-cta {
    text-align: center;
    margin-top: 3rem;
    padding: 2.5rem 2rem;
    background: white;
    border-radius: var(--radius-lg);
  }

  .kr-cta h3 { margin-bottom: 0.5rem; }

  .kr-cta p {
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
  }

  .kr-cta-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
