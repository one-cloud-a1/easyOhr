---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ZubehoerBild from '../../components/ZubehoerBild.astro'
import AddZubehoerButton from '../../components/AddZubehoerButton.tsx'
import zubehoer from '../../data/zubehoer.json'
import { url } from '../../lib/links'

export function getStaticPaths() {
  return zubehoer.produkte.map(p => ({ params: { slug: p.slug }, props: { produkt: p } }))
}

const { produkt } = Astro.props
const p = produkt as any

const verwandt = zubehoer.produkte
  .filter(x => x.kategorie === p.kategorie && x.slug !== p.slug)
  .slice(0, 4)

const kategorieName = p.kategorie === 'batterie' ? 'Batterien' : 'Cerumenfilter'
---
<BaseLayout title={p.name} description={`${p.name} — ${p.beschreibung.slice(0, 150)}`}>
  <section class="zd">
    <div class="container">
      <nav class="breadcrumb">
        <a href={url('/')}>Start</a><span>/</span>
        <a href={url('/zubehoer/')}>Zubehör</a><span>/</span>
        <span>{p.name}</span>
      </nav>

      <div class="zd-grid">
        {p.bilder && p.bilder.length > 0 ? (
          <div class="zd-galerie">
            <div class="zd-galerie-haupt">
              <img id="zd-haupt" src={url(p.bilder[0])} alt={p.name} />
            </div>
            {p.bilder.length > 1 && (
              <div class="zd-galerie-thumbs">
                {p.bilder.map((b: string, i: number) => (
                  <button type="button" class:list={['zd-thumb', { aktiv: i === 0 }]} data-src={url(b)} aria-label={`Bild ${i + 1} anzeigen`}>
                    <img src={url(b)} alt="" loading="lazy" />
                  </button>
                ))}
              </div>
            )}
          </div>
        ) : (
          <div class="zd-bild">
            <ZubehoerBild kategorie={p.kategorie} farbeHex={p.farbeHex} gross={true} />
            {p.evolution && <span class="zd-evo">Evolution</span>}
          </div>
        )}

        <div class="zd-info">
          <span class="zd-marke">{p.marke ?? `${p.typ} · Zink-Luft`}</span>
          <h1>{p.name}</h1>
          <p class="zd-desc">{p.beschreibung}</p>

          <div class="zd-fakten">
            <div><span>Inhalt</span><strong>{p.packung}</strong></div>
            {p.kategorie === 'batterie'
              ? <div><span>Größe</span><strong>{p.typ} · {p.farbe}</strong></div>
              : <div><span>Passend für</span><strong>{p.fuer}</strong></div>}
          </div>

          <div class="zd-preis-zeile">
            <span class="zd-preis">{p.preis.toLocaleString('de-DE', { minimumFractionDigits: 2 })} €</span>
            <span class="zd-preis-hint">inkl. MwSt.</span>
          </div>

          {p.staffel && (
            <p class="zd-staffel">
              <strong>Mengenrabatt:</strong> ab {p.staffel.abMenge} Paketen je {p.staffel.preis.toLocaleString('de-DE', { minimumFractionDigits: 2 })} €
            </p>
          )}

          <AddZubehoerButton client:load slug={p.slug} name={p.name} variante={p.packung} preis={p.preis} staffelAbMenge={p.staffel?.abMenge} staffelPreis={p.staffel?.preis} />

          <p class="zd-versand">
            Versandkostenfrei ab 49 € — sonst 5,90 €.
            <a href={url('/versand/')}>Versandinfos</a>
          </p>
        </div>
      </div>

      {((p.technik && p.technik.length > 0) || p.lieferumfang || p.hersteller) && (
        <div class="zd-technik">
          {p.technik && p.technik.length > 0 && (
            <>
              <h2>Technische Details</h2>
              <ul class="zd-technik-liste">
                {p.technik.map((t: string) => <li>{t}</li>)}
              </ul>
            </>
          )}
          {p.lieferumfang && (
            <p class="zd-meta"><strong>Lieferumfang:</strong> {p.lieferumfang}</p>
          )}
          {p.hinweis && <p class="zd-hinweis-klein">{p.hinweis}</p>}
          {p.hersteller && (
            <div class="zd-hersteller">
              <h3>Hersteller</h3>
              <address>
                {p.hersteller.firma}<br />
                {p.hersteller.strasse}<br />
                {p.hersteller.plzOrt}<br />
                {p.hersteller.land}
              </address>
            </div>
          )}
        </div>
      )}

      {verwandt.length > 0 && (
        <div class="zd-verwandt">
          <h2>Weitere {kategorieName}</h2>
          <div class="zd-verwandt-grid">
            {verwandt.map(v => (
              <a href={url(`/zubehoer/${v.slug}/`)} class="zd-vkarte">
                <div class="zd-vbild">
                  {(v as any).bilder && (v as any).bilder.length > 0
                    ? <img src={url((v as any).bilder[0])} alt={v.name} loading="lazy" />
                    : <ZubehoerBild kategorie={v.kategorie} farbeHex={(v as any).farbeHex} />}
                </div>
                <div>
                  <h4>{v.name}</h4>
                  <span>{v.preis.toLocaleString('de-DE', { minimumFractionDigits: 2 })} €</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .zd { padding: 0 0 2rem; }
  .breadcrumb {
    display: flex; gap: 0.5rem; font-size: 0.85rem;
    color: var(--color-text-muted); padding: 1.5rem 0;
  }
  .breadcrumb a { color: var(--color-text-muted); }
  .breadcrumb a:hover { color: var(--color-primary); }

  .zd-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-bottom: 3rem; }

  .zd-bild {
    position: relative;
    background: var(--color-secondary);
    border-radius: var(--radius-xl);
    display: flex; align-items: center; justify-content: center;
    min-height: 320px;
  }
  .zd-evo {
    position: absolute; top: 1.25rem; right: 1.25rem;
    font-size: 0.75rem; font-weight: 600;
    background: var(--color-accent-light); color: var(--color-accent);
    padding: 0.3rem 0.875rem; border-radius: 100px;
  }

  /* Foto-Galerie (Hauptbild + Thumbnails) */
  .zd-galerie { display: flex; flex-direction: column; gap: 0.75rem; }
  .zd-galerie-haupt {
    background: var(--color-secondary);
    border-radius: var(--radius-xl);
    display: flex; align-items: center; justify-content: center;
    aspect-ratio: 1 / 1; overflow: hidden;
  }
  .zd-galerie-haupt img { width: 100%; height: 100%; object-fit: contain; }
  .zd-galerie-thumbs { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.5rem; }
  .zd-thumb {
    border: 2px solid var(--color-border-light); border-radius: var(--radius-sm);
    background: var(--color-secondary); padding: 0; cursor: pointer;
    overflow: hidden; aspect-ratio: 1 / 1; transition: border-color 0.15s ease;
  }
  .zd-thumb:hover { border-color: var(--color-primary); }
  .zd-thumb.aktiv { border-color: var(--color-primary); }
  .zd-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .zd-staffel {
    font-size: 0.9rem; color: var(--color-accent);
    background: var(--color-accent-light);
    padding: 0.5rem 0.875rem; border-radius: var(--radius-sm);
    margin-bottom: 1.25rem;
  }

  /* Technische Details / Hersteller (v. a. Power One EVOLUTION) */
  .zd-technik {
    padding: 2.5rem 0;
    border-top: 1px solid var(--color-border-light);
  }
  .zd-technik h2 { margin-bottom: 1.25rem; }
  .zd-technik-liste {
    list-style: none; padding: 0; max-width: 560px;
    display: flex; flex-direction: column; gap: 0;
  }
  .zd-technik-liste li {
    display: flex; align-items: baseline; gap: 0.75rem;
    padding: 0.6rem 0; font-size: 0.92rem;
    border-bottom: 1px solid var(--color-border-light);
  }
  .zd-technik-liste li::before {
    content: ''; flex: 0 0 6px; width: 6px; height: 6px;
    border-radius: 50%; background: var(--color-primary);
    transform: translateY(-1px);
  }
  .zd-meta { font-size: 0.92rem; margin-top: 1.25rem; }
  .zd-hinweis-klein { font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.5rem; font-style: italic; }
  .zd-hersteller { margin-top: 1.75rem; }
  .zd-hersteller h3 { font-size: 1rem; margin-bottom: 0.5rem; }
  .zd-hersteller address {
    font-style: normal; font-size: 0.9rem; line-height: 1.6;
    color: var(--color-text-light);
  }

  .zd-marke {
    font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;
    color: var(--color-text-muted); font-weight: 500;
  }
  .zd-info h1 { font-size: 1.85rem; margin: 0.5rem 0 1rem; }
  .zd-desc { color: var(--color-text-light); line-height: 1.7; margin-bottom: 1.5rem; }

  .zd-fakten {
    display: flex; flex-direction: column; gap: 0.5rem;
    padding: 1rem 1.25rem; background: var(--color-secondary);
    border-radius: var(--radius-md); margin-bottom: 1.5rem;
  }
  .zd-fakten > div { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.9rem; }
  .zd-fakten span { color: var(--color-text-muted); }
  .zd-fakten strong { text-align: right; }

  .zd-preis-zeile { display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 1.25rem; }
  .zd-preis { font-size: 2rem; font-weight: 700; }
  .zd-preis-hint { font-size: 0.85rem; color: var(--color-text-muted); }

  .zd-versand { font-size: 0.85rem; color: var(--color-text-muted); margin-top: 1rem; }
  .zd-versand a { color: var(--color-primary); margin-left: 0.375rem; }

  .zd-verwandt { padding: 2.5rem 0; border-top: 1px solid var(--color-border-light); }
  .zd-verwandt h2 { margin-bottom: 1.5rem; }
  .zd-verwandt-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .zd-vkarte {
    display: flex; align-items: center; gap: 0.875rem;
    padding: 0.875rem; border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md); text-decoration: none; color: var(--color-text);
    transition: border-color 0.15s ease;
  }
  .zd-vkarte:hover { border-color: var(--color-primary); }
  .zd-vbild {
    width: 56px; height: 56px; flex-shrink: 0;
    background: var(--color-secondary); border-radius: var(--radius-sm);
    display: flex; align-items: center; justify-content: center;
  }
  .zd-vbild :global(svg) { width: 40px; height: 40px; }
  .zd-vbild img { width: 100%; height: 100%; object-fit: contain; border-radius: var(--radius-sm); }
  .zd-vkarte h4 { font-size: 0.9rem; margin-bottom: 0.125rem; }
  .zd-vkarte span { font-size: 0.85rem; color: var(--color-primary); font-weight: 600; }

  @media (max-width: 768px) {
    .zd-grid { grid-template-columns: 1fr; gap: 2rem; }
    .zd-verwandt-grid { grid-template-columns: 1fr 1fr; }
  }
</style>

<style is:global>
  .azb { margin-top: 0.5rem; }
  .azb-btn {
    width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem;
    padding: 0.9rem; background: var(--color-accent); color: white; border: none;
    border-radius: var(--radius-md); font-family: var(--font-sans); font-size: 1rem;
    font-weight: 600; cursor: pointer; transition: background 0.2s;
  }
  .azb-btn:hover { background: #9A6013; }
  .azb-btn-ok { background: var(--color-success); }
  .azb-link {
    display: block; text-align: center; margin-top: 0.75rem;
    font-size: 0.9rem; font-weight: 600; color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .zd-galerie-thumbs { grid-template-columns: repeat(6, 1fr); }
  }
</style>

<script>
  // Galerie: Thumbnail anklicken tauscht das Hauptbild.
  const haupt = document.getElementById('zd-haupt') as HTMLImageElement | null
  document.querySelectorAll<HTMLButtonElement>('.zd-thumb').forEach(thumb => {
    thumb.addEventListener('click', () => {
      const src = thumb.getAttribute('data-src')
      if (src && haupt) haupt.src = src
      document.querySelectorAll('.zd-thumb').forEach(t => t.classList.remove('aktiv'))
      thumb.classList.add('aktiv')
    })
  })
</script>
