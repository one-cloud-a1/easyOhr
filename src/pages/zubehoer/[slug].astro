---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ZubehoerBild from '../../components/ZubehoerBild.astro'
import AddZubehoerButton from '../../components/AddZubehoerButton.tsx'
import zubehoer from '../../data/zubehoer.json'
import { url } from '../../lib/links'

export function getStaticPaths() {
  return zubehoer.produkte.map(p => ({ params: { slug: p.slug }, props: { produkt: p } }))
}

const { produkt } = Astro.props
const p = produkt as any

const verwandt = zubehoer.produkte
  .filter(x => x.kategorie === p.kategorie && x.slug !== p.slug)
  .slice(0, 4)

const kategorieName = p.kategorie === 'batterie' ? 'Batterien' : 'Cerumenfilter'
---
<BaseLayout title={p.name} description={`${p.name} — ${p.beschreibung.slice(0, 150)}`}>
  <section class="zd">
    <div class="container">
      <nav class="breadcrumb">
        <a href={url('/')}>Start</a><span>/</span>
        <a href={url('/zubehoer/')}>Zubehör</a><span>/</span>
        <span>{p.name}</span>
      </nav>

      <div class="zd-grid">
        <div class="zd-bild">
          <ZubehoerBild kategorie={p.kategorie} farbeHex={p.farbeHex} gross={true} />
          {p.evolution && <span class="zd-evo">Evolution</span>}
        </div>

        <div class="zd-info">
          <span class="zd-marke">{p.marke ?? `${p.typ} · Zink-Luft`}</span>
          <h1>{p.name}</h1>
          <p class="zd-desc">{p.beschreibung}</p>

          <div class="zd-fakten">
            <div><span>Inhalt</span><strong>{p.packung}</strong></div>
            {p.kategorie === 'batterie'
              ? <div><span>Größe</span><strong>{p.typ} · {p.farbe}</strong></div>
              : <div><span>Passend für</span><strong>{p.fuer}</strong></div>}
          </div>

          <div class="zd-preis-zeile">
            <span class="zd-preis">{p.preis.toLocaleString('de-DE', { minimumFractionDigits: 2 })} €</span>
            <span class="zd-preis-hint">inkl. MwSt.</span>
          </div>

          <AddZubehoerButton client:load slug={p.slug} name={p.name} variante={p.packung} preis={p.preis} />

          <p class="zd-versand">
            Versandkostenfrei ab 49 € — sonst 5,90 €.
            <a href={url('/versand/')}>Versandinfos</a>
          </p>
        </div>
      </div>

      {verwandt.length > 0 && (
        <div class="zd-verwandt">
          <h2>Weitere {kategorieName}</h2>
          <div class="zd-verwandt-grid">
            {verwandt.map(v => (
              <a href={url(`/zubehoer/${v.slug}/`)} class="zd-vkarte">
                <div class="zd-vbild"><ZubehoerBild kategorie={v.kategorie} farbeHex={(v as any).farbeHex} /></div>
                <div>
                  <h4>{v.name}</h4>
                  <span>{v.preis.toLocaleString('de-DE', { minimumFractionDigits: 2 })} €</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .zd { padding: 0 0 2rem; }
  .breadcrumb {
    display: flex; gap: 0.5rem; font-size: 0.85rem;
    color: var(--color-text-muted); padding: 1.5rem 0;
  }
  .breadcrumb a { color: var(--color-text-muted); }
  .breadcrumb a:hover { color: var(--color-primary); }

  .zd-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-bottom: 3rem; }

  .zd-bild {
    position: relative;
    background: var(--color-secondary);
    border-radius: var(--radius-xl);
    display: flex; align-items: center; justify-content: center;
    min-height: 320px;
  }
  .zd-evo {
    position: absolute; top: 1.25rem; right: 1.25rem;
    font-size: 0.75rem; font-weight: 600;
    background: var(--color-accent-light); color: var(--color-accent);
    padding: 0.3rem 0.875rem; border-radius: 100px;
  }

  .zd-marke {
    font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;
    color: var(--color-text-muted); font-weight: 500;
  }
  .zd-info h1 { font-size: 1.85rem; margin: 0.5rem 0 1rem; }
  .zd-desc { color: var(--color-text-light); line-height: 1.7; margin-bottom: 1.5rem; }

  .zd-fakten {
    display: flex; flex-direction: column; gap: 0.5rem;
    padding: 1rem 1.25rem; background: var(--color-secondary);
    border-radius: var(--radius-md); margin-bottom: 1.5rem;
  }
  .zd-fakten > div { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.9rem; }
  .zd-fakten span { color: var(--color-text-muted); }
  .zd-fakten strong { text-align: right; }

  .zd-preis-zeile { display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 1.25rem; }
  .zd-preis { font-size: 2rem; font-weight: 700; }
  .zd-preis-hint { font-size: 0.85rem; color: var(--color-text-muted); }

  .zd-versand { font-size: 0.85rem; color: var(--color-text-muted); margin-top: 1rem; }
  .zd-versand a { color: var(--color-primary); margin-left: 0.375rem; }

  .zd-verwandt { padding: 2.5rem 0; border-top: 1px solid var(--color-border-light); }
  .zd-verwandt h2 { margin-bottom: 1.5rem; }
  .zd-verwandt-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .zd-vkarte {
    display: flex; align-items: center; gap: 0.875rem;
    padding: 0.875rem; border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md); text-decoration: none; color: var(--color-text);
    transition: border-color 0.15s ease;
  }
  .zd-vkarte:hover { border-color: var(--color-primary); }
  .zd-vbild {
    width: 56px; height: 56px; flex-shrink: 0;
    background: var(--color-secondary); border-radius: var(--radius-sm);
    display: flex; align-items: center; justify-content: center;
  }
  .zd-vbild :global(svg) { width: 40px; height: 40px; }
  .zd-vkarte h4 { font-size: 0.9rem; margin-bottom: 0.125rem; }
  .zd-vkarte span { font-size: 0.85rem; color: var(--color-primary); font-weight: 600; }

  @media (max-width: 768px) {
    .zd-grid { grid-template-columns: 1fr; gap: 2rem; }
    .zd-verwandt-grid { grid-template-columns: 1fr 1fr; }
  }
</style>

<style is:global>
  .azb { margin-top: 0.5rem; }
  .azb-btn {
    width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem;
    padding: 0.9rem; background: var(--color-accent); color: white; border: none;
    border-radius: var(--radius-md); font-family: var(--font-sans); font-size: 1rem;
    font-weight: 600; cursor: pointer; transition: background 0.2s;
  }
  .azb-btn:hover { background: #9A6013; }
  .azb-btn-ok { background: var(--color-success); }
  .azb-link {
    display: block; text-align: center; margin-top: 0.75rem;
    font-size: 0.9rem; font-weight: 600; color: var(--color-primary);
  }
</style>
